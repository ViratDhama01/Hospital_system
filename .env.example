# Copy to .env for local Docker Compose runs and replace the development values.
POSTGRES_DB=hospital_db
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_PORT=5432
APP_PORT=8000
HOSPITAL_SECRET_KEY=change-this-development-secret

# Leave DATABASE_URL unset to use the local SQLite development fallback.
# For local PostgreSQL outside Compose, use localhost as the host.
# DATABASE_URL=postgresql://hospital_user:change-this-development-password@localhost:5432/hospital_db
